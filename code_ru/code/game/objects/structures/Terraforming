#define TERRATOWER_BUILDSTATE_REQUIRE_PARTS 1
#define TERRATOWER_BUILDSTATE_BLOWTORCH 2
#define TERRATOWER_BUILDSTATE_WIRECUTTERS 3
#define TERRATOWER_BUILDSTATE_WRENCH 4



